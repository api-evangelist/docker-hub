        {
          "id": "ffca37f9-55ea-4e13-b202-6e5fcfd23bb6",
          "name": "Second factor authentication",
          "request": {
            "name": "Second factor authentication",
            "description": {
              "content": "When a user has two-factor authentication (2FA) enabled, this is the second call to perform after `/v2/users/login` call.\n\nCreates and returns a bearer token in JWT format that you can use to authenticate with Docker Hub APIs.\n\nThe returned token is used in the HTTP Authorization header like `Authorization: Bearer {TOKEN}`.\n\nMost Docker Hub APIs require this token either to consume or to get detailed information. For example, to list images in a private repository.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "users",
                "2fa-login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login_2fa_token\": \"<string>\",\n  \"code\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "0cf64665-8768-4f5c-a034-7cd10d95d791",
              "name": "Authentication successful",
